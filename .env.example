# Copy to .env for docker compose: cp .env.example .env

# dev enables placeholder server keys and the /test endpoints: never use it outside a local stack
APP_ENV=dev

# Leave empty to print sign-in codes to the server log instead of sending email
RESEND_API_KEY=

# Required when APP_ENV is not dev: base64 of at least 32 random bytes (openssl rand -base64 32)
# Changing either one later orphans every existing account and membership
# MIUCHIO_EMAIL_HMAC_KEY=
# MIUCHIO_USER_LINK_KEY=

# Object storage: the bundled MinIO by default, any S3 compatible store works
# Address the server container uses
S3_ENDPOINT=http://minio:9000
# Address the phone uses for presigned links: your computer's LAN IP
S3_PUBLIC_ENDPOINT=http://192.168.1.10:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=miuchio
S3_REGION=auto
USE_PATH_STYLE=true
