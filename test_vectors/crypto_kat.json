  "canonical_json": [
    {
      "name": "empty object",
      "input_json": "{}",
      "expected_utf8": "{}"
    },
    {
      "name": "primitive types",
      "input_json": "{\"b\":true,\"f\":false,\"n\":null,\"i\":-42}",
      "expected_utf8": "{\"b\":true,\"f\":false,\"i\":-42,\"n\":null}"
    },
    {
      "name": "key sort by UTF-8 byte order (capitals before lowercase)",
      "input_json": "{\"b\":1,\"a\":2,\"B\":3,\"A\":4}",
      "expected_utf8": "{\"A\":4,\"B\":3,\"a\":2,\"b\":1}"
    },
    {
      "name": "nested map: inner keys also sorted",
      "input_json": "{\"outer\":{\"z\":1,\"a\":2},\"prefix\":\"x\"}",
      "expected_utf8": "{\"outer\":{\"a\":2,\"z\":1},\"prefix\":\"x\"}"
    },
    {
      "name": "list preserves insertion order",
      "input_json": "[3,1,2]",
      "expected_utf8": "[3,1,2]"
    },
    {
      "name": "string escapes: only minimum JSON escapes",
      "input_json": "{\"s\":\"a\\\"b\\\\c\\nd\\te\"}",
      "expected_utf8": "{\"s\":\"a\\\"b\\\\c\\nd\\te\"}"
    },
    {
      "name": "control char escapes (U+0001)",
      "input_json": "{\"x\":\"\\u0001\"}",
      "expected_utf8": "{\"x\":\"\\u0001\"}"
    },
    {
      "name": "non-ASCII preserved as raw UTF-8",
      "input_json": "{\"x\":\"héllo\"}",
      "expected_utf8": "{\"x\":\"héllo\"}"
    }
  ]
}
